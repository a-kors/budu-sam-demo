---
import { master } from '../data/master';
import CtaGroup from './CtaGroup.astro';
---

<section id="contacts" class="compact cta">
  <div class="wrap">
  <div class="panel" data-reveal>
    <div class="text">
      <span class="section-eyebrow">Запись на&nbsp;занятие</span>
      <h2>
        Будем рады познакомиться с&nbsp;вашей семьёй и&nbsp;помочь ребёнку
        сделать <em>важные шаги к&nbsp;самостоятельности</em>.
      </h2>
      <ul class="addr">
        {master.addresses.map((a) => (
          <li><span class="addr-line">{a.line}</span><span class="addr-note">{a.note}</span></li>
        ))}
      </ul>
    </div>
    <div class="actions">
      <CtaGroup variant="primary" tone="dark" />
      <a class="btn btn-ghost" href={master.phoneHref}>
        <span>Позвонить: {master.phone}</span>
      </a>
    </div>
  </div>
  </div>
</section>

<style>
  .cta {
    padding-top: clamp(40px, 5vw, 80px);
  }
  .addr {
    list-style: none;
    margin: 24px 0 0;
    padding: 0;
    display: grid;
    gap: 14px;
  }
  .addr li {
    display: flex;
    flex-direction: column;
    gap: 2px;
  }
  .addr-line {
    color: #ffffff;
    font-size: 16px;
  }
  .addr-note {
    color: rgba(255, 255, 255, 0.6);
    font-size: 14px;
  }
  .panel {
    background: var(--ink);
    color: #ffffff;
    padding: clamp(40px, 6vw, 80px) clamp(28px, 5vw, 64px);
    border-radius: var(--radius-lg);
    display: grid;
    grid-template-columns: 1.3fr 1fr;
    gap: 48px;
    align-items: center;
  }
  .panel .section-eyebrow {
    color: var(--accent-line);
  }
  h2 {
    font-size: clamp(28px, 3.6vw, 44px);
    line-height: 1.15;
    letter-spacing: -0.02em;
    margin-top: 16px;
    color: #ffffff;
  }
  h2 em {
    font-style: italic;
    color: var(--accent-line);
  }
  .actions {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 14px;
  }
  .actions :global(.btn-primary) {
    background: var(--accent);
    color: #ffffff;
  }
  .actions :global(.btn-primary):hover {
    background: var(--accent-hover);
  }
  .actions .btn-ghost {
    color: var(--accent-line);
    padding: 0;
    font-size: 14px;
  }
  .actions .btn-ghost:hover {
    color: #ffffff;
  }
  @media (max-width: 860px) {
    .panel {
      grid-template-columns: 1fr;
    }
  }
</style>
