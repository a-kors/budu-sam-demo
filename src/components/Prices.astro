---
import { prices } from '../data/master';
import CtaGroup from './CtaGroup.astro';
---

<section id="prices" class="pr">
  <div class="wrap">
    <header class="section-head" data-reveal>
      <span class="section-eyebrow">Цены</span>
      <h2>Стоимость занятий.</h2>
      <p>
        Оплата наличными, переводом или по&nbsp;QR-коду. Условия гибкие:
        подберём удобный формат посещения. Точную стоимость уточните при&nbsp;записи.
      </p>
    </header>

    <div class="grid">
      {prices.groups.map((g, i) => (
        <article class={`card ${i === 0 ? 'card--on' : ''}`} data-reveal data-reveal-delay={i * 100}>
          <h3>{g.title}</h3>
          <ul>
            {g.rows.map((r) => (
              <li>
                <span class="name">{r.name}</span>
                <span class="dots" aria-hidden="true"></span>
                <span class="price">{r.price}</span>
              </li>
            ))}
          </ul>
        </article>
      ))}
    </div>

    <div class="foot" data-reveal>
      <p class="note">Цены {prices.updated}, не&nbsp;являются публичной офертой.</p>
      <CtaGroup variant="primary" label="Записаться на занятие" />
    </div>
  </div>
</section>

<style>
  .pr {
    background: var(--bg);
  }
  .grid {
    display: grid;
    grid-template-columns: 1.2fr 1fr 1fr;
    gap: 18px;
    align-items: stretch;
  }
  .card {
    background: #ffffff;
    border: 1px solid var(--line);
    border-radius: 18px;
    padding: 28px 26px 22px;
  }
  .card--on {
    background: var(--ink);
    border-color: var(--ink);
  }
  h3 {
    font-family: var(--font-serif);
    font-size: 22px;
    font-weight: 400;
    color: var(--ink);
    margin: 0 0 18px;
    letter-spacing: -0.01em;
  }
  .card--on h3 {
    color: #ffffff;
  }
  ul {
    list-style: none;
    margin: 0;
    padding: 0;
  }
  li {
    display: flex;
    align-items: baseline;
    gap: 10px;
    padding: 12px 0;
    border-top: 1px solid var(--line);
    font-size: 15.5px;
  }
  .card--on li {
    border-color: rgba(255, 255, 255, 0.14);
  }
  .name {
    color: var(--ink);
  }
  .card--on .name {
    color: rgba(255, 255, 255, 0.86);
  }
  .dots {
    flex: 1;
    border-bottom: 1px dotted var(--line-strong);
    transform: translateY(-4px);
  }
  .card--on .dots {
    border-color: rgba(255, 255, 255, 0.22);
  }
  .price {
    font-family: var(--font-serif);
    font-size: 19px;
    color: var(--ink);
    white-space: nowrap;
  }
  .card--on .price {
    color: #ffffff;
  }
  .foot {
    margin-top: 36px;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 20px;
    flex-wrap: wrap;
  }
  .note {
    margin: 0;
    font-size: 13.5px;
    color: var(--ink-muted);
  }

  @media (max-width: 960px) {
    .grid {
      grid-template-columns: 1fr 1fr;
    }
    .card--on {
      grid-column: span 2;
    }
  }
  @media (max-width: 600px) {
    .grid {
      grid-template-columns: 1fr;
    }
    .card--on {
      grid-column: auto;
    }
    .foot {
      flex-direction: column;
      align-items: flex-start;
    }
  }
</style>
