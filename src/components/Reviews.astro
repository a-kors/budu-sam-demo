---
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import { master, textReviews } from '../data/master';

const imgs = import.meta.glob<{ default: ImageMetadata }>('/src/assets/reviews/*.jpg', { eager: true });
const shots = Object.entries(imgs)
  .sort(([a], [b]) => {
    const ai = parseInt(a.match(/review-(\d+)/)?.[1] || '0', 10);
    const bi = parseInt(b.match(/review-(\d+)/)?.[1] || '0', 10);
    return ai - bi;
  })
  .map(([, mod]) => mod.default);

// чередуем скрины и текстовые карточки, чтобы стена не была однородной
type Item = { type: 'shot'; img: ImageMetadata; i: number } | { type: 'text'; r: (typeof textReviews)[number] };
const items: Item[] = [];
const n = Math.max(shots.length, textReviews.length);
for (let i = 0; i < n; i++) {
  if (textReviews[i]) items.push({ type: 'text', r: textReviews[i] });
  if (shots[i]) items.push({ type: 'shot', img: shots[i], i });
}
---

<section id="reviews" class="rv">
  <div class="wrap">
    <header class="section-head" data-reveal>
      <span class="section-eyebrow">Отзывы родителей</span>
      <h2>Что пишут семьи, которые к&nbsp;нам ходят.</h2>
      <p>
        Отзывы из&nbsp;2ГИС: дословно, с&nbsp;именами и&nbsp;датами, как их
        оставили родители.
      </p>
    </header>

    <div class="rv__wall" data-wall>
      <div class="rv__cols">
        <a class="rc rc--score" href={master.gis} target="_blank" rel="noopener" data-reveal>
          <span class="rc__kind">Рейтинг в&nbsp;2ГИС</span>
          <span class="score">4,6</span>
          <span class="stars" aria-hidden="true">★★★★★</span>
          <p class="muted">56 оценок по&nbsp;двум филиалам: 39 на&nbsp;Взлётной и&nbsp;17 на&nbsp;Павловском тракте.</p>
          <span class="rc__link">Все отзывы в&nbsp;2ГИС →</span>
        </a>

        {items.map((it, k) =>
          it.type === 'text' ? (
            <figure class="rc rc--text" data-reveal data-reveal-delay={Math.min(k * 50, 300)}>
              <blockquote>{it.r.text}</blockquote>
              <figcaption>
                <span class="who">{it.r.name}</span>
                <span class="when">{it.r.date} · 2ГИС</span>
              </figcaption>
            </figure>
          ) : (
            <a
              class="rc rc--photo"
              href={master.gis}
              target="_blank"
              rel="noopener"
              data-reveal="tilt"
              data-reveal-delay={Math.min(k * 50, 300)}
              aria-label={`Отзыв из 2ГИС, скриншот ${it.i + 1}`}
            >
              <Image
                src={it.img}
                alt={`Отзыв родителя в 2ГИС, скриншот ${it.i + 1}`}
                widths={[400, 700]}
                sizes="(max-width: 600px) 90vw, 360px"
                format="webp"
                loading="lazy"
              />
            </a>
          )
        )}
      </div>
      <div class="rv__fade" aria-hidden="true"></div>
    </div>

    <div class="rv__footer">
      <button class="btn btn-secondary" type="button" data-more>
        <span>Показать все отзывы</span>
        <span class="arrow" aria-hidden="true">↓</span>
      </button>
      <a class="btn btn-ghost" href={master.gis} target="_blank" rel="noopener">
        Открыть 2ГИС →
      </a>
    </div>
  </div>
</section>

<script>
  document.querySelectorAll<HTMLElement>('[data-wall]').forEach((wall) => {
    const section = wall.closest('section');
    const btn = section?.querySelector<HTMLButtonElement>('[data-more]');
    const fits = () => {
      if (!wall.classList.contains('is-open') && wall.scrollHeight <= wall.clientHeight + 40) {
        wall.classList.add('is-open');
        if (btn) btn.style.display = 'none';
      }
    };
    fits();
    window.addEventListener('load', () => setTimeout(fits, 1200));
    btn?.addEventListener('click', () => {
      wall.classList.add('is-open');
      btn.style.display = 'none';
    });
  });
</script>

<style>
  .rv {
    background: var(--bg-soft);
  }
  .rv__wall {
    position: relative;
    max-height: 1800px;
    overflow: hidden;
    transition: max-height 0.6s ease;
    margin-bottom: 32px;
  }
  .rv__wall.is-open {
    max-height: none;
  }
  .rv__wall.is-open .rv__fade {
    display: none;
  }
  .rv__fade {
    position: absolute;
    left: 0;
    right: 0;
    bottom: 0;
    height: 220px;
    background: linear-gradient(to bottom, rgba(243, 237, 225, 0), var(--bg-soft) 92%);
    pointer-events: none;
  }
  .rv__cols {
    columns: 3;
    column-gap: 16px;
  }
  .rc {
    display: block;
    break-inside: avoid;
    margin: 0 0 16px;
    border-radius: 14px;
    overflow: hidden;
    background: #ffffff;
    box-shadow:
      0 1px 2px rgba(31, 25, 21, 0.05),
      0 6px 20px rgba(31, 25, 21, 0.06);
    text-decoration: none;
    color: inherit;
    transition: transform 0.2s ease, box-shadow 0.2s ease;
  }
  .rc:hover {
    transform: translateY(-2px);
    box-shadow:
      0 2px 4px rgba(31, 25, 21, 0.08),
      0 18px 32px rgba(31, 25, 21, 0.1);
  }
  .rc--photo :global(img) {
    width: 100%;
    height: auto;
    display: block;
  }
  .rc__poster {
    aspect-ratio: 3 / 4;
    position: relative;
    display: flex;
    align-items: center;
    justify-content: center;
    overflow: hidden;
    background: var(--ink);
  }
  .rc__poster-img {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center;
    display: block;
  }
  .rc__shade {
    position: absolute;
    inset: 0;
    background:
      radial-gradient(circle at 50% 42%, rgba(0,0,0,0.0) 0%, rgba(0,0,0,0.35) 70%),
      linear-gradient(180deg, rgba(31,25,21,0.15) 0%, rgba(31,25,21,0.55) 100%);
  }
  .rc__play {
    position: relative;
    z-index: 1;
    width: 62px;
    height: 62px;
    border-radius: 50%;
    background: rgba(255, 255, 255, 0.96);
    color: var(--ink);
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 17px;
    padding-left: 4px;
    box-shadow: 0 16px 32px -8px rgba(0, 0, 0, 0.45);
  }
  .rc__dur {
    z-index: 1;
  }
  .rc__dur {
    position: absolute;
    bottom: 10px;
    right: 10px;
    font-size: 11px;
    color: rgba(255, 255, 255, 0.9);
    background: rgba(0, 0, 0, 0.35);
    padding: 3px 8px;
    border-radius: 999px;
    letter-spacing: 0.04em;
  }
  .rc--score {
    display: flex;
    flex-direction: column;
    gap: 8px;
    padding: 26px 24px 24px;
    background: var(--sun-soft);
    box-shadow: none;
    border: 1px solid var(--sun);
  }
  .score {
    font-family: var(--font-serif);
    font-size: 64px;
    line-height: 1;
    color: var(--ink);
    letter-spacing: -0.02em;
  }
  .stars {
    color: #e2a53b;
    letter-spacing: 3px;
    font-size: 18px;
  }
  .rc--score .muted {
    margin: 4px 0 6px;
    font-size: 14.5px;
    line-height: 1.5;
  }
  .rc__link {
    font-size: 14px;
    color: var(--ink);
  }
  .rc--text {
    padding: 24px 24px 20px;
  }
  .rc--text blockquote {
    margin: 0 0 18px;
    font-size: 15px;
    line-height: 1.6;
    color: var(--ink);
  }
  .rc--text blockquote::before {
    content: '«';
    font-family: var(--font-serif);
    color: var(--accent);
    margin-right: 1px;
  }
  .rc--text blockquote::after {
    content: '»';
    font-family: var(--font-serif);
    color: var(--accent);
    margin-left: 1px;
  }
  .rc--text figcaption {
    display: flex;
    flex-direction: column;
    gap: 2px;
    padding-top: 14px;
    border-top: 1px solid var(--line);
  }
  .who {
    font-weight: 500;
    font-size: 14.5px;
    color: var(--ink);
  }
  .when {
    font-size: 12.5px;
    color: var(--ink-soft);
  }
  .rc__body {
    padding: 18px 20px 20px;
  }
  .rc__kind {
    font-size: 11px;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--ink-soft);
  }
  .rc__body h3 {
    font-family: var(--font-serif);
    font-size: 20px;
    line-height: 1.22;
    margin: 8px 0 8px;
    font-weight: 400;
    letter-spacing: -0.015em;
    color: var(--ink);
  }
  .muted {
    color: var(--ink-muted);
  }

  .rv__footer {
    position: relative;
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: center;
    gap: 14px 28px;
    margin-top: 12px;
  }

  @media (max-width: 960px) {
    .rv__wall {
      max-height: 1600px;
    }
    .rv__cols {
      columns: 2;
    }
  }
  @media (max-width: 520px) {
    .rv__wall {
      max-height: 1800px;
    }
    .rv__cols {
      columns: 1;
    }
  }
</style>
