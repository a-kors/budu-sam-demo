---
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import { quotes, master } from '../data/master';

const imgs = import.meta.glob<{ default: ImageMetadata }>('/src/assets/gallery/*.jpg', { eager: true });
const gallery = Object.entries(imgs)
  .sort(([a], [b]) => a.localeCompare(b))
  .map(([, mod]) => mod.default);
const alts = [
  'Групповое занятие за столом',
  'Специалист и ребёнок на занятии',
  'Шведская стенка в игровой зоне',
  'Ребёнок играет в игровой зоне',
  'Занятие с развивающим материалом',
  'Детские работы на стене',
];
---

<section class="space" aria-labelledby="space-h">
  <div class="wrap">
    <div class="head">
      <header class="section-head" data-reveal>
        <span class="section-eyebrow">Какие условия созданы в&nbsp;центре</span>
        <h2 id="space-h">Светлое, уютное пространство, где&nbsp;хочется заниматься.</h2>
        <p>
          Большая материально-техническая база: пособия, дидактические
          материалы, развивающие игры и&nbsp;оборудование. В&nbsp;игровой зоне
          много игрушек и&nbsp;сюжетно-ролевых игр, которые развивают
          воображение и&nbsp;коммуникацию.
        </p>
      </header>
      <figure class="q" data-reveal data-reveal-delay="120">
        <blockquote>«{quotes.space}»</blockquote>
        <figcaption>{master.head}</figcaption>
      </figure>
    </div>

    <div class="gallery">
      {gallery.map((img, i) => (
        <figure class={`g g-${i + 1}`} data-reveal data-reveal-delay={Math.min(i * 70, 300)}>
          <Image
            src={img}
            alt={alts[i] ?? 'Центр «Буду Сам»'}
            widths={[480, 800, 1200]}
            sizes="(max-width: 760px) 92vw, 50vw"
            format="webp"
            quality={82}
            loading="lazy"
          />
        </figure>
      ))}
    </div>
  </div>
</section>

<style>
  .space {
    background: #ffffff;
  }
  .head {
    display: grid;
    grid-template-columns: 1.2fr 1fr;
    gap: clamp(28px, 5vw, 72px);
    align-items: end;
    margin-bottom: 48px;
  }
  .head .section-head {
    margin-bottom: 0;
  }
  .q {
    margin: 0;
    padding: 28px 30px;
    background: var(--accent-soft);
    border-radius: 18px;
  }
  .q blockquote {
    margin: 0 0 14px;
    font-family: var(--font-serif);
    font-size: 19px;
    line-height: 1.5;
    color: var(--ink);
  }
  .q figcaption {
    font-size: 12.5px;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--ink-muted);
  }
  .gallery {
    display: grid;
    grid-template-columns: repeat(6, 1fr);
    grid-auto-rows: clamp(140px, 17vw, 230px);
    gap: 14px;
  }
  .g {
    margin: 0;
    border-radius: 16px;
    overflow: hidden;
    background: var(--bg-soft);
  }
  .g :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }
  .g-1 { grid-column: span 4; grid-row: span 2; }
  .g-2 { grid-column: span 2; }
  .g-3 { grid-column: span 2; }
  .g-4 { grid-column: span 2; }
  .g-5 { grid-column: span 2; }
  .g-6 { grid-column: span 2; }

  @media (max-width: 860px) {
    .head {
      grid-template-columns: 1fr;
      align-items: start;
    }
    .gallery {
      grid-template-columns: repeat(2, 1fr);
      grid-auto-rows: clamp(130px, 30vw, 220px);
    }
    .g-1 { grid-column: span 2; grid-row: span 2; }
    .g-2, .g-3, .g-4, .g-5, .g-6 { grid-column: span 1; grid-row: span 1; }
    .g-6 { display: none; }
  }
</style>
